{
	"name": "job-match",
	"compatibility_date": "2026-09-01",
	// /api/* runs the Worker (application tracking over D1); every other path is the static
	// dashboard. Cloudflare Access protects both. CF_ACCESS_AUD and CF_ACCESS_TEAM_DOMAIN are
	// Worker secrets (`wrangler secret put`), never vars: vars missing here are wiped on deploy.
	"main": "worker/src/index.js",
	// The PDF font (ADR 0017 part 3) is bundled as bytes; worker/package.json lists the PDF and
	// zip libraries, installed by `npm ci --prefix worker` before deploy.
	"rules": [
		{
			"type": "Data",
			"globs": ["**/*.ttf"],
			"fallthrough": true
		}
	],
	// The AI rerank (ADR 0016): 30 minutes after the daily run (07:00 UTC), and once more at
	// 09:30 to catch a late run (the content cache makes the second pass free when nothing is
	// new). ANTHROPIC_API_KEY is a Worker secret. AI_DAILY_LIMIT is the cap on calls per day
	// (billed answers only, 4xx/5xx are free); config/settings.yaml ai.daily_limit repeats it, a test keeps them equal.
	// The third cron (ADR 0017) generates the application documents pending in D1, five per pass.
	"triggers": {
		"crons": [
			"30 7 * * *",
			"30 9 * * *",
			"*/10 * * * *"
		]
	},
	// AI_DOCUMENTS_MONTHLY_USD caps the month's estimated spend on the documents model
	// (config/settings.yaml documents.monthly_budget_usd repeats it, a test keeps them equal).
	// AI_INBOX_DAILY_LIMIT caps the Haiku calls the recruiter inbox makes a day (ADR 0018;
	// config/settings.yaml ai.inbox_daily_limit repeats it). ACCESS_SERVICE_CN, the Client ID of
	// the Access service token n8n uses (the JWT's common_name, "<hex>.access"), is a Worker
	// secret like the other Access identifiers: this file is public.
	"vars": {
		"AI_DAILY_LIMIT": "100",
		"AI_DOCUMENTS_MONTHLY_USD": "60",
		"AI_INBOX_DAILY_LIMIT": "50"
	},
	// Workers AI, the fallback once the Claude API says the credit is spent.
	"ai": {
		"binding": "AI"
	},
	// The private bucket for the master CV, the contact sheet and the generated documents
	// (ADR 0017). No "remote" key: `wrangler dev` uses a local R2, never the production one.
	"r2_buckets": [
		{
			"binding": "DOCS",
			"bucket_name": "job-match-docs"
		}
	],
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			// The Worker reads env.DB. The id comes from `wrangler d1 create job-match` (not a
			// secret: it is useless without an API token on the account). No "remote" key:
			// `wrangler dev` must use a local D1, never the production one.
			"binding": "DB",
			"database_name": "job-match",
			"database_id": "6239cf4b-0d6f-42aa-9736-3ef901a64956",
			"migrations_dir": "worker/migrations"
		}
	]
}