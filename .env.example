# Job sources. Which ones actually run is set in config/settings.yaml (sources.enabled);
# a source with no credentials here is skipped with a warning and the run continues.

# France Travail API credentials (OAuth2 client-credentials)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Jooble — one key, passed in the request path (jooble.org/api/keys)
JOOBLE_API_KEY=

# Adzuna — disabled by default, the free tier is too small (developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Profile (CI only): base64-encoded contents of config/profile.yaml
# Locally, place the real profile at config/profile.yaml instead.
PROFILE_YAML=

# Email digest (M8)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=         # Gmail: use an App Password (not your account password)
DIGEST_TO=you@example.com

# job-match-scorer (EXPERIMENTAL, optional): path to a local checkout
JMS_PATH=

# AI rerank (ADR 0016): the Claude API key is a Cloudflare Worker secret
# (`npx wrangler secret put ANTHROPIC_API_KEY`), never a CI variable and never in this file.
# The daily cap is the wrangler var AI_DAILY_LIMIT (wrangler.jsonc); the smoke test
# (scripts/ai-smoke.mjs) needs the key in .dev.vars (gitignored), never here.
