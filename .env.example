# France Travail API credentials (OAuth2 client-credentials)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Profile (CI only): base64-encoded contents of config/profile.yaml
# Locally, place the real profile at config/profile.yaml instead.
PROFILE_YAML=

# Email digest (M8)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=         # Gmail: use an App Password (not your account password)
DIGEST_TO=you@example.com

# job-match-scorer (EXPERIMENTAL, optional): path to a local checkout
JMS_PATH=
